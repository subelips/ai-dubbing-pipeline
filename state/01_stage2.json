    {
      "id": 7,
      "start": 8.55,
      "end": 9.23,
      "speaker_id": "SPEAKER_01_F",
      "gender": "female",
      "src_text": "吃",
      "text_vi": "Đây là bữa cơm trưa hôm nay"
    },
    {
      "id": 8,
      "start": 21.88,
      "end": 22.89,
      "speaker_id": "SPEAKER_00_M",
      "gender": "male",
      "src_text": "这是今天的午餐",
      "text_vi": "Đây là bữa cơm trưa hôm nay."
    },
    {
      "id": 9,
      "start": 24.04,
      "end": 24.84,
      "speaker_id": "SPEAKER_00_M",
      "gender": "male",
      "src_text": "结婚三年",
      "text_vi": "Chúng tôi đã kết hôn được ba năm."
    },
    {
      "id": 10,
      "start": 25.24,
      "end": 25.56,
      "speaker_id": "SPEAKER_00_M",
      "gender": "male",
      "src_text": "Z",
      "text_vi": "Tôi."
    },
    {
      "id": 11,
      "start": 25.59,
      "end": 26.96,
      "speaker_id": "SPEAKER_00_M",
      "gender": "male",
      "src_text": "我的妻子对餐饮要求",
      "text_vi": "Tôi rất khó tính trong việc ăn uống."
    },
    {
      "id": 12,
      "start": 26.99,
      "end": 28.25,
      "speaker_id": "SPEAKER_00_M",
      "gender": "male",
      "src_text": "苛刻到极致",
      "text_vi": "Khó tính đến cực điểm"
    },
    {
      "id": 13,
      "start": 28.28,
      "end": 28.71,
      "speaker_id": "SPEAKER_00_M",
      "gender": "male",
      "src_text": "Z",
      "text_vi": "Không bao giờ ăn đồ mang về từ xa"
    },
    {
      "id": 14,
      "start": 28.74,
      "end": 29.76,
      "speaker_id": "SPEAKER_00_M",
      "gender": "male",
      "src_text": "从不吃外卖",
      "text_vi": "Không ăn thức ăn vặt"
    },
    {
      "id": 15,
      "start": 29.81,
      "end": 30.65,
      "speaker_id": "SPEAKER_00_M",
      "gender": "male",
      "src_text": "不碰垃圾食品",
      "text_vi": "Vì vậy tôi thức dậy lúc 4 giờ mỗi ngày"
    },
    {
      "id": 16,
      "start": 31.06,
      "end": 32.52,
      "speaker_id": "SPEAKER_00_M",
      "gender": "male",
      "src_text": "所以我每天四点起",
      "text_vi": "Vì vậy tôi thức dậy lúc 4 giờ mỗi ngày."
    },
    {
      "id": 17,
      "start": 32.98,
      "end": 35.68,
      "speaker_id": "SPEAKER_00_M",
      "gender": "male",
      "src_text": "给她做最健康卫生的三餐",
      "text_vi": "Tôi sẽ nấu cho cô những bữa ăn dinh dưỡng nhất"
    },
    {
      "id": 18,
      "start": 35.71,
      "end": 36.75,
      "speaker_id": "SPEAKER_01_F",
      "gender": "female",
      "src_text": "今天食材新鲜吗",
      "text_vi": "Ngày hôm nay có đủ thực phẩm tươi mới không?"
    },
    {
      "id": 19,
      "start": 37.14,
      "end": 38.14,
      "speaker_id": "SPEAKER_02_M",
      "gender": "male",
      "src_text": "都是早上四点",
      "text_vi": "Có tất cả đều nấu từ 4 giờ sáng"
    },
    {
      "id": 20,
      "start": 38.18,
      "end": 39.75,
      "speaker_id": "SPEAKER_02_M",
      "gender": "male",
      "src_text": "从菜市场买最新鲜的食材",
      "text_vi": "Mua nguyên liệu tươi nhất từ chợ"
    },
    {
      "id": 21,
      "start": 39.98,
      "end": 40.75,
      "speaker_id": "SPEAKER_01_F",
      "gender": "female",
      "src_text": "菜擦洗了几遍",
      "text_vi": "Rửa rau bao nhiêu lần"
