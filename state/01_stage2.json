    {
      "id": 30,
      "start": 49.19,
      "end": 50.91,
      "speaker_id": "SPEAKER_01_F",
      "gender": "female",
      "src_text": "会引起别人不必要的揣测",
      "text_vi": "Đó sẽ gây ra những suy đoán không cần thiết cho người khác"
