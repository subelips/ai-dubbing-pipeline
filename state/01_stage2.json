    {
      "id": 23,
      "start": 41.67,
      "end": 42.69,
      "speaker_id": "SPEAKER_00_M",
      "gender": "male",
      "src_text": "还用果蔬清洁剂",
      "text_vi": "Rửa thêm chất tẩy rửa rau quả"
