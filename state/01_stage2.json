    {
      "id": 34,
      "start": 62.84,
      "end": 63.31,
      "speaker_id": "SPEAKER_00_M",
      "gender": "male",
      "src_text": "乂亲 炎辰",
      "text_vi": "Anh đi đón mẹ của rồi."
    },
    {
      "id": 35,
      "start": 63.5,
      "end": 64.75,
      "speaker_id": "SPEAKER_00_M",
      "gender": "male",
      "src_text": "你又去给瑶瑶送饭了",
      "text_vi": "Chúng ta nên cảm ơn anh ấy vì công sức của anh ấy"
