      "speaker_id": "SPEAKER_01_F",
      "gender": "female",
      "src_text": "你走吧",
      "text_vi": "Chào đi"
    },
    {
      "id": 28,
      "start": 45.85,
      "end": 47.09,
      "speaker_id": "SPEAKER_01_F",
      "gender": "female",
      "src_text": "你一个行政部的小职员",
      "text_vi": "Bạn là một nhân viên văn phòng nhỏ"
    },
    {
      "id": 29,
      "start": 47.41,
      "end": 48.49,
      "speaker_id": "SPEAKER_01_F",
      "gender": "female",
      "src_text": "跟我这待太久",
      "text_vi": "Tôi ở đây lâu quá"
