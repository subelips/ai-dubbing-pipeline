    {
      "id": 24,
      "start": 42.72,
      "end": 43.55,
      "speaker_id": "SPEAKER_00_M",
      "gender": "male",
      "src_text": "浸泡了十五分钟",
      "text_vi": "Đã ngâm trong 15 phút"
