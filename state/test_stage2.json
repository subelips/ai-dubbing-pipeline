    {
      "id": 42,
      "start": 85.59,
      "end": 85.88,
      "speaker_id": "SPEAKER_00_M",
      "gender": "male",
      "src_text": "二是不想让公司上下知道",
      "text_vi": "Để không làm cho mọi người trong công ty biết"
