    {
      "id": 13,
      "start": 31.06,
      "end": 32.57,
      "speaker_id": "SPEAKER_02_M",
      "gender": "male",
      "src_text": "所以我每天四点起给",
      "text_vi": "làm bữa ăn sáng, trưa, tối sạch sẽ và lành mạnh nhất"
