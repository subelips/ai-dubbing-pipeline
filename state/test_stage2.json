      "id": 11,
      "start": 28.17,
      "end": 28.41,
      "speaker_id": "SPEAKER_02_M",
      "gender": "male",
      "src_text": "从",
      "text_vi": "không ăn đồ ăn nhanh, không chạm đến thực phẩm chế biến sẵn"
