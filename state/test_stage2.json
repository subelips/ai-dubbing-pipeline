      "id": 14,
      "start": 33.0,
      "end": 35.16,
      "speaker_id": "SPEAKER_02_M",
      "gender": "male",
      "src_text": "她做最健康卫生的三餐",
      "text_vi": "Ngày hôm nay nguyên liệu có tươi không?"
