      "id": 12,
      "start": 28.72,
      "end": 30.59,
      "speaker_id": "SPEAKER_02_M",
      "gender": "male",
      "src_text": "不吃外卖,不碰垃圾食品",
      "text_vi": "Vì vậy mỗi ngày tôi thức dậy lúc bốn giờ để"
