{
  "job_id": "ep01",
  "video_asset": "https://drive.google.com/file/d/1Y-I3ye5Z0sNfdZvGzqgwpt4f4yPdQjyU/view?usp=drive_link",
  "scene_context": "",
  "segments": [
    {
      "id": 0,
      "start": 1.26,
      "end": 1.94,
      "speaker_id": "SPEAKER_00",
      "asr_text": "老婆"
    },
    {
      "id": 1,
      "start": 1.94,
      "end": 4.06,
      "speaker_id": "SPEAKER_00",
      "asr_text": "你的饭给狗吃了"
    },
    {
      "id": 2,
      "start": 4.06,
      "end": 5.24,
      "speaker_id": "SPEAKER_00",
      "asr_text": "你就该吃狗的"
    },
    {
      "id": 3,
      "start": 5.24,
      "end": 6.44,
      "speaker_id": "SPEAKER_00",
      "asr_text": "狗吃完了"
    },
    {
      "id": 4,
      "start": 6.44,
      "end": 7.94,
      "speaker_id": "SPEAKER_00",
      "asr_text": "该你吃了"
    },
    {
      "id": 5,
      "start": 7.94,
      "end": 8.76,
      "speaker_id": "SPEAKER_00",
      "asr_text": "吃"
    },
    {
      "id": 6,
      "start": 8.76,
      "end": 22.87,
      "speaker_id": "SPEAKER_00",
      "asr_text": "这是今天的午餐"
    },
    {
      "id": 7,
      "start": 22.87,
      "end": 24.77,
      "speaker_id": "SPEAKER_00",
      "asr_text": "结婚三年"
    },
    {
      "id": 8,
      "start": 24.77,
      "end": 28.25,
      "speaker_id": "SPEAKER_00",
      "asr_text": "我的妻子对餐饮要求苛刻到极致"
    },
    {
      "id": 9,
      "start": 28.25,
      "end": 29.49,
      "speaker_id": "SPEAKER_00",
      "asr_text": "从不吃外卖"
    },
    {
      "id": 10,
      "start": 29.49,
      "end": 30.67,
      "speaker_id": "SPEAKER_00",
      "asr_text": "不碰垃圾食品"
    },
    {
      "id": 11,
      "start": 30.67,
      "end": 32.47,
      "speaker_id": "SPEAKER_00",
      "asr_text": "所以我每天四点起"
    },
    {
      "id": 12,
      "start": 32.47,
      "end": 35.27,
      "speaker_id": "SPEAKER_00",
      "asr_text": "给她做最健康卫生的三餐"
    },
    {
      "id": 13,
      "start": 35.27,
      "end": 36.91,
      "speaker_id": "SPEAKER_00",
      "asr_text": "今天食材新鲜吗"
    },
    {
      "id": 14,
      "start": 36.91,
      "end": 37.99,
      "speaker_id": "SPEAKER_00",
      "asr_text": "都是早上四点"
    },
    {
      "id": 15,
      "start": 37.99,
      "end": 39.79,
      "speaker_id": "SPEAKER_00",
      "asr_text": "从菜市场买最新鲜的食材"
    },
    {
      "id": 16,
      "start": 39.79,
      "end": 40.75,
      "speaker_id": "SPEAKER_00",
      "asr_text": "菜市场洗了几遍"
    },
    {
      "id": 17,
      "start": 40.75,
      "end": 41.31,
      "speaker_id": "SPEAKER_00",
      "asr_text": "三遍"
    },
    {
      "id": 18,
      "start": 41.31,
      "end": 42.61,
      "speaker_id": "SPEAKER_00",
      "asr_text": "还用果蔬清洁剂"
    },
    {
      "id": 19,
      "start": 42.61,
      "end": 43.57,
      "speaker_id": "SPEAKER_00",
      "asr_text": "浸泡了十五分钟"
    },
    {
      "id": 20,
      "start": 43.57,
      "end": 44.23,
      "speaker_id": "SPEAKER_00",
      "asr_text": "行了"
    },
    {
      "id": 21,
      "start": 44.23,
      "end": 45.37,
      "speaker_id": "SPEAKER_00",
      "asr_text": "你走吧"
    },
    {
      "id": 22,
      "start": 45.37,
      "end": 47.31,
      "speaker_id": "SPEAKER_00",
      "asr_text": "你一个行政部的小职员"
    },
    {
      "id": 23,
      "start": 47.31,
      "end": 48.59,
      "speaker_id": "SPEAKER_00",
      "asr_text": "跟我这儿待待久"
    },
    {
      "id": 24,
      "start": 48.59,
      "end": 50.69,
      "speaker_id": "SPEAKER_00",
      "asr_text": "会引起别人不必要的喘息"
    },
    {
      "id": 25,
      "start": 50.69,
      "end": 55.22,
      "speaker_id": "SPEAKER_00",
      "asr_text": "好"
    },
    {
      "id": 26,
      "start": 55.22,
      "end": 56.92,
      "speaker_id": "SPEAKER_00",
      "asr_text": "那你趁热吃"
    },
    {
      "id": 27,
      "start": 56.92,
      "end": 58.78,
      "speaker_id": "SPEAKER_00",
      "asr_text": "凉了对胃不好"
    },
    {
      "id": 28,
      "start": 58.78,
      "end": 63.21,
      "speaker_id": "SPEAKER_00",
      "asr_text": "言辰"
    },
    {
      "id": 29,
      "start": 63.21,
      "end": 64.95,
      "speaker_id": "SPEAKER_00",
      "asr_text": "你又去给瑶瑶送饭了"
    },
    {
      "id": 30,
      "start": 64.95,
      "end": 66.09,
      "speaker_id": "SPEAKER_00",
      "asr_text": "真是辛苦你了"
    },
    {
      "id": 31,
      "start": 66.09,
      "end": 66.85,
      "speaker_id": "SPEAKER_00",
      "asr_text": "照顾妻子"
    },
    {
      "id": 32,
      "start": 66.85,
      "end": 69.11,
      "speaker_id": "SPEAKER_00",
      "asr_text": "只是我作为丈夫的责任"
    },
    {
      "id": 33,
      "start": 69.11,
      "end": 70.99,
      "speaker_id": "SPEAKER_00",
      "asr_text": "当年要不是你"
    },
    {
      "id": 34,
      "start": 70.99,
      "end": 73.05,
      "speaker_id": "SPEAKER_00",
      "asr_text": "与我们夏氏商业联姻"
    },
    {
      "id": 35,
      "start": 73.05,
      "end": 74.31,
      "speaker_id": "SPEAKER_00",
      "asr_text": "我们夏氏集团"
    },
    {
      "id": 36,
      "start": 74.31,
      "end": 76.01,
      "speaker_id": "SPEAKER_00",
      "asr_text": "早在三年前就破产了"
    },
    {
      "id": 37,
      "start": 76.01,
      "end": 77.81,
      "speaker_id": "SPEAKER_00",
      "asr_text": "你谈谈陆氏集团继承人"
    },
    {
      "id": 38,
      "start": 77.81,
      "end": 79.01,
      "speaker_id": "SPEAKER_00",
      "asr_text": "甘愿引信埋名"
    },
    {
      "id": 39,
      "start": 79.01,
      "end": 79.73,
      "speaker_id": "SPEAKER_00",
      "asr_text": "来我们公司"
    },
    {
      "id": 40,
      "start": 79.73,
      "end": 80.57,
      "speaker_id": "SPEAKER_00",
      "asr_text": "做一个小职员"
    },
    {
      "id": 41,
      "start": 80.57,
      "end": 82.81,
      "speaker_id": "SPEAKER_00",
      "asr_text": "一次次帮公司填窟窿"
    },
    {
      "id": 42,
      "start": 82.81,
      "end": 83.79,
      "speaker_id": "SPEAKER_00",
      "asr_text": "我隐瞒身份"
    },
    {
      "id": 43,
      "start": 83.79,
      "end": 85.75,
      "speaker_id": "SPEAKER_00",
      "asr_text": "一是不想让公司上下知道"
    },
    {
      "id": 44,
      "start": 85.75,
      "end": 87.39,
      "speaker_id": "SPEAKER_00",
      "asr_text": "夏氏靠陆氏撑腰"
    },
    {
      "id": 45,
      "start": 87.39,
      "end": 88.75,
      "speaker_id": "SPEAKER_00",
      "asr_text": "免得人心浮动"
    },
    {
      "id": 46,
      "start": 88.75,
      "end": 90.97,
      "speaker_id": "SPEAKER_00",
      "asr_text": "二也是对明瑶的一种考验吧"
    },
    {
      "id": 47,
      "start": 90.97,
      "end": 92.13,
      "speaker_id": "SPEAKER_00",
      "asr_text": "明瑶她不懂事"
    },
    {
      "id": 48,
      "start": 92.13,
      "end": 93.93,
      "speaker_id": "SPEAKER_00",
      "asr_text": "我知道你的好"
    },
    {
      "id": 49,
      "start": 93.93,
      "end": 95.39,
      "speaker_id": "SPEAKER_00",
      "asr_text": "我作为当爸的"
    },
    {
      "id": 50,
      "start": 95.39,
      "end": 97.45,
      "speaker_id": "SPEAKER_00",
      "asr_text": "真的很感激你啊"
    },
    {
      "id": 51,
      "start": 97.45,
      "end": 97.69,
      "speaker_id": "SPEAKER_00",
      "asr_text": "不用"
    },
    {
      "id": 52,
      "start": 97.69,
      "end": 102.36,
      "speaker_id": "SPEAKER_00",
      "asr_text": "我车钥匙落在餐厅里"
    },
    {
      "id": 53,
      "start": 102.36,
      "end": 103.84,
      "speaker_id": "SPEAKER_00",
      "asr_text": "我回去拿一下"
    }
  ]
}