  "screen_texts": [
    {
      "time": 0.8,
      "start": 0.0,
      "end": 1.6,
      "text": "老婆"
    },
    {
      "time": 2.9,
      "start": 1.6,
      "end": 4.2,
      "text": "你的饭绐狗吃了"
    },
    {
      "time": 23.2,
      "start": 22.6,
      "end": 24.8,
      "text": "结婚三年"
    },
    {
      "time": 25.7,
      "start": 24.8,
      "end": 26.6,
      "text": "我的妻子对餐饮要求"
    },
    {
      "time": 28.0,
      "start": 27.4,
      "end": 28.6,
      "text": "从不吃外卖"
    },
    {
      "time": 30.1,
      "start": 28.6,
      "end": 31.6,
      "text": "不碰垃圾食品"
    },
    {
      "time": 32.6,
      "start": 32.2,
      "end": 35.6,
      "text": "给她做最健康卫生的三餐"
    },
    {
      "time": 36.3,
      "start": 35.6,
      "end": 37.0,
      "text": "都是早上四点"
    },
    {
      "time": 38.4,
      "start": 37.0,
      "end": 39.8,
      "text": "从莱市场买最新鲜的食材"
    },
    {
      "time": 40.4,
      "start": 39.8,
      "end": 41.0,
      "text": "三遍"
    },
    {
      "time": 41.65,
      "start": 41.0,
      "end": 42.3,
      "text": "还用果蔬清洁剂"
    },
    {
      "time": 42.95,
      "start": 42.3,
      "end": 43.6,
      "text": "浸泡了十五分钟"
    },
    {
      "time": 46.45,
      "start": 45.8,
      "end": 47.1,
      "text": "你一个行政部的小职员"
    },
    {
      "time": 47.75,
      "start": 47.1,
      "end": 48.4,
      "text": "跟我这待太久"
    },
    {
      "time": 49.6,
      "start": 48.4,
      "end": 50.8,
      "text": "会引起别入不必要的揣测"
    },
    {
      "time": 55.85,
      "start": 54.8,
      "end": 56.9,
      "text": "那你趁热吃"
    },
    {
      "time": 57.95,
      "start": 56.9,
      "end": 59.0,
      "text": "凉了对胃不好"
    },
    {
      "time": 62.6,
      "start": 61.8,
      "end": 64.8,
      "text": "你又去给瑶瑶送饭了"
    },
    {
      "time": 65.2,
      "start": 64.8,
      "end": 65.6,
      "text": "真是辛苦你了"
    },
    {
      "time": 65.9,
      "start": 65.6,
      "end": 66.8,
      "text": "照顾妻子"
    },
    {
      "time": 67.1,
      "start": 66.8,
      "end": 69.0,
      "text": "只是我作为丈夫的责任"
    },
    {
      "time": 69.5,
      "start": 69.0,
      "end": 70.6,
      "text": "当年要不是你"
    },
    {
      "time": 71.0,
      "start": 70.6,
      "end": 72.9,
      "text": "与我们夏氏商业联姻"
    },
    {
      "time": 73.15,
      "start": 72.9,
      "end": 73.8,
      "text": "我们夏氏集团"
    },
    {
      "time": 74.0,
      "start": 73.8,
      "end": 75.2,
      "text": "早在三年前就破产了"
    },
    {
      "time": 75.7,
      "start": 75.2,
      "end": 76.2,
      "text": "你堂堂陆氏集团继承入"
    },
    {
      "time": 76.9,
      "start": 76.2,
      "end": 77.6,
      "text": "你堂堂陆氏集团继承人"
    },
    {
      "time": 77.8,
      "start": 77.6,
      "end": 78.0,
      "text": "甘愿隐姓埋名"
    },
    {
      "time": 79.3,
      "start": 78.0,
      "end": 80.6,
      "text": "来我们公司做一个小职员"
    },
    {
      "time": 80.9,
      "start": 80.6,
      "end": 81.2,
      "text": "一次次帮公司填窟窿"
    },
    {
      "time": 82.1,
      "start": 81.2,
      "end": 83.5,
      "text": "我隐瞒身份"
    },
    {
      "time": 83.75,
      "start": 83.5,
      "end": 85.0,
      "text": "一是不想让公司上下知道"
    },
    {
      "time": 85.5,
      "start": 85.0,
      "end": 86.0,
      "text": "是不想让公司匕下知道"
    },
    {
      "time": 86.45,
      "start": 86.0,
      "end": 86.9,
      "text": "夏氏靠陆氏撑腰"
    },
    {
      "time": 87.35,
      "start": 86.9,
      "end": 88.6,
      "text": "免得人心浮动"
    },
    {
      "time": 89.0,
      "start": 88.6,
      "end": 90.3,
      "text": "也是对明瑶的一种考验吧"
    },
    {
      "time": 90.75,
      "start": 90.3,
      "end": 92.4,
      "text": "明瑶她不懂事"
    },
    {
      "time": 92.6,
      "start": 92.4,
      "end": 93.6,
      "text": "不知道你的好"
    },
    {
      "time": 94.0,
      "start": 93.6,
      "end": 95.3,
      "text": "我作为当爸的"
    },
    {
      "time": 95.75,
      "start": 95.3,
      "end": 97.0,
      "text": "真的很感激你啊"
    },
    {
      "time": 97.2,
      "start": 97.0,
      "end": 97.4,
      "text": "不用"
    },
    {
      "time": 100.5,
      "start": 99.6,
      "end": 101.4,
      "text": "我车钥匙落在餐厅了"
    },
    {
      "time": 101.6,
      "start": 101.4,
      "end": 101.8,
      "text": "我车钥匙落荏餐厅了"
    },
    {
      "time": 102.0,
      "start": 101.8,
      "end": 102.2,
      "text": "我车钥匙落在餐厅了"
    }
